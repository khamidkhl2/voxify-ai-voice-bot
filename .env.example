# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz

# 2. Your Telegram User ID (get it from @userinfobot)
ADMIN_IDS=123456789

# 3. CryptoPay API Token from @CryptoBot (Type /pay -> Create App)
# Optional: If left empty, ad purchases can be reviewed manually
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_NET=mainnet

# 4. VIP Price in Telegram Stars
VIP_PRICE_STARS=50

# 5. Number of referrals needed to unlock 1 month of free VIP
REFERRALS_FOR_VIP=3

# 6. Fallback ad text if no sponsor is currently active
FALLBACK_AD_TEXT=📢 Promote your channel here! Tap /advertise
FALLBACK_AD_URL=https://t.me/CryptoBot

# 7. Custom TTS API (Optional: If left empty, built-in free Edge-TTS neural engine is used)
CUSTOM_TTS_API_URL=
CUSTOM_TTS_API_KEY=
